# Marvel Legendary Randomizer Environment Configuration

# Custom backend C# API address.
# If empty or not set, the app will try the relative `/api/cards` endpoint or fall back to `/cards-data.json`.
# Examples:
# VITE_API_URL=https://api.frostpointlabs.com
# VITE_API_URL=https://localhost:7001
# VITE_API_URL=http://localhost:5000
VITE_API_URL=https://api.frostpointlabs.com
